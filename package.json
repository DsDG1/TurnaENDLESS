{
  "name": "endless",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @endless/web --filter @endless/api dev",
    "build": "pnpm -C apps/api typecheck && pnpm -C apps/web build",
    "preview": "pnpm --parallel --filter @endless/web --filter @endless/api preview",
    "dev:api": "pnpm -C apps/api dev",
    "test:e2e": "pnpm -C apps/web test:e2e",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lab": "pnpm -C apps/lab exec tsx src/cli.ts",
    "lab:assert": "pnpm -C apps/lab exec tsx src/cli.ts assert"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
