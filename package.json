{
  "name": "endless",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @endless/web --filter @endless/api dev",
    "build": "pnpm -C apps/api typecheck && pnpm -C apps/web build",
    "build:cloud": "pnpm -C apps/api typecheck && pnpm -C apps/web build:cloud",
    "dev:cloud": "pnpm --parallel --filter @endless/web --filter @endless/api dev:cloud",
    "preview": "pnpm --parallel --filter @endless/web --filter @endless/api preview",
    "dev:api": "pnpm -C apps/api dev",
    "desktop:build": "pnpm build && pnpm -C apps/desktop build",
    "desktop": "pnpm desktop:build && pnpm -C apps/desktop start",
    "desktop:package": "pnpm desktop:build && pnpm -C apps/desktop package",
    "desktop:test": "pnpm -C apps/desktop test:smoke --packaged",
    "test:e2e": "pnpm -C apps/web build:cloud && pnpm -C apps/web test:e2e && pnpm -C apps/web test:e2e:local",
    "typecheck": "pnpm -r --if-present typecheck",
    "check:boundaries": "node --test scripts/check-boundaries.test.mjs && node scripts/check-boundaries.mjs",
    "test": "pnpm check:boundaries && pnpm -r --if-present test",
    "lab": "pnpm -C apps/lab exec tsx src/cli.ts",
    "lab:assert": "pnpm -C apps/lab exec tsx src/cli.ts assert"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
